# Dataset, indices and models are mounted as a volume, never copied in.
data/

# Hidden files and folders at the top level: VCS metadata, CI config, editor
# and local tool settings, env files. Nothing in them is needed in the image.
.*

# Python and tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.coverage
htmlcov/

# Not needed at runtime
tests/
docs/
*.md
Dockerfile
.dockerignore
requirements-dev.txt
pyproject.toml
Makefile
tasks.py
*.log
.env
.env.*
